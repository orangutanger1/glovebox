{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "environment": "development",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "channel": "preview"
    },
    "redesign-check": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_DESIGN": "redesign"
      }
    },
    "design-v2-check": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_DESIGN": "redesign",
        "EXPO_PUBLIC_DESIGN_V2": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.idea6.carmaintenancelog",
        "ascAppId": "6797103341"
      }
    }
  }
}
