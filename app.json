{
  "expo": {
    "name": "Wrenchy",
    "slug": "car-maintenance-log",
    "scheme": "carmaintenancelog",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.idea6.carmaintenancelog",
      "supportsTablet": true,
      "requireFullScreen": true,
      "buildNumber": "45",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "en-GB",
          "en-AU",
          "en-CA",
          "de",
          "fr",
          "fr-CA",
          "it",
          "es",
          "es-MX",
          "pt-BR",
          "nl",
          "sv",
          "pl",
          "ja",
          "ko"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F1113",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.idea6.carmaintenancelog.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.idea6.carmaintenancelog",
          "widgets": [
            {
              "name": "NextService",
              "displayName": "Next service",
              "description": "What your car needs next, and when.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wrenchy uses your photos only when you attach one to a glovebox document. It stays on this iPhone.",
          "cameraPermission": "Wrenchy uses the camera only when you photograph a glovebox document. The photo stays on this iPhone.",
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd84867d-9447-4a57-991a-d7e6a8ef1ac6"
      }
    },
    "owner": "mayfield",
    "updates": {
      "url": "https://u.expo.dev/fd84867d-9447-4a57-991a-d7e6a8ef1ac6",
      "fallbackToCacheTimeout": 10000
    }
  }
}
