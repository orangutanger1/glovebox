{
  "expo": {
    "name": "Wrenchy",
    "slug": "car-maintenance-log",
    "scheme": "carmaintenancelog",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.idea6.carmaintenancelog",
      "supportsTablet": false,
      "buildNumber": "23",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "en-GB",
          "en-AU",
          "en-CA",
          "de",
          "fr",
          "fr-CA",
          "it",
          "es",
          "es-MX",
          "pt-BR",
          "nl",
          "sv",
          "pl",
          "ja",
          "ko"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F1113",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd84867d-9447-4a57-991a-d7e6a8ef1ac6"
      }
    },
    "owner": "nakodan-capital",
    "updates": {
      "url": "https://u.expo.dev/fd84867d-9447-4a57-991a-d7e6a8ef1ac6"
    }
  }
}
