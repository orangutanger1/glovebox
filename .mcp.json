{
  "mcpServers": {
    "revenuecat": {
      "type": "http",
      "url": "https://mcp.revenuecat.ai/mcp",
      "headers": {
        "Authorization": "!printf 'Bearer %s' \"$(cat \"$HOME/.omp/revenuecat/car.key\" 2>/dev/null)\""
      }
    },
    "astro": {
      "type": "http",
      "url": "${ASTRO_MCP_URL:-http://127.0.0.1:8089/mcp}",
      "timeout": 20000
    },
    "apple-ads": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "apple-search-ads-mcp@latest"
      ],
      "env": {
        "ASA_CLIENT_ID": "${ASA_CLIENT_ID:-}",
        "ASA_TEAM_ID": "${ASA_TEAM_ID:-}",
        "ASA_KEY_ID": "${ASA_KEY_ID:-}",
        "ASA_PRIVATE_KEY_PATH": "${ASA_PRIVATE_KEY_PATH:-$HOME/.asc/asa-private.p8}",
        "ASA_ORG_ID": "${ASA_ORG_ID:-}"
      }
    }
  }
}
